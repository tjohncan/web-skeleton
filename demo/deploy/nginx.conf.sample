# Reverse proxy for the web-skeleton demo. A sample, not a drop-in: the
# server_name and certificate paths are yours.
#
# TLS terminates here because the framework has no inbound TLS and is not
# going to grow any — it is the network and protocol layer, and a TLS
# implementation is neither. What it does have is an outbound client, which
# is why libssl is optional in the image rather than absent.

# ---------------------------------------------------------------------------
# Sharing a box with another site
#
# The three directives below are http-block directives, not server-block
# ones, and nginx refuses to start if any is declared twice. If this box already
# proxies something else that speaks WebSocket, its config almost certainly
# has its own `map $http_upgrade`, and dropping this file in beside it fails
# with "duplicate map" or "duplicate zone" — at reload, taking the site that
# was already working down with it.
#
# So on a shared box, move the map and both zones into the http block
# of nginx.conf (or a snippet included once from it), and keep only the two
# server blocks here. One nginx, one map, one server block per subdomain, each
# proxying to its own loopback port — not one nginx per application.
# ---------------------------------------------------------------------------

# The upgrade pair, hoisted because it has to live in the http block.
# "Connection: upgrade" must be sent only for requests that asked to upgrade;
# sending it on every request breaks keep-alive for ordinary ones.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# This bounds HTTP requests: page loads, lab GETs, upgrade attempts. Every
# control on the page is O(1) per click by design, but that is a property of
# the page, and the page is not what arrives here — a script is.
#
# It does not bound what happens on a WebSocket. An upgraded connection is one
# request, so every frame after the handshake goes past limit_req uncounted.
# The bulletin's defence against a socket posting as fast as it can write is
# the per-connection post budget in the application, not this.
limit_req_zone $binary_remote_addr zone=ws_demo:10m rate=10r/s;

# The budget is per socket, so bounding a client takes both proxy limits, and
# they cover two different floods. A client can HOLD many sockets at once —
# this zone caps that, sixteen per address (limit_conn, below on /ws). Or it
# can CHURN them: close and reopen, since each new socket gets a fresh budget
# of five. limit_req (above, at server level) bounds churn by capping how fast
# new sockets open — ten a second, burst twenty — so the ceiling is about
# fifty posts a second (ten new sockets, five posts each) after a one-time
# burst of twenty sockets, rather than unbounded. Neither flood is the
# application's to stop: behind a proxy it cannot tell one client's many
# sockets from many clients.
limit_conn_zone $binary_remote_addr zone=ws_demo_conns:10m;

server {
    listen 443 ssl;
    # The standalone directive needs nginx 1.25.1 or later. Older builds —
    # Ubuntu 24.04 ships 1.24, Debian bookworm 1.22 — refuse to start on it;
    # for those, drop this line and write `listen 443 ssl http2;` above.
    http2 on;
    server_name demo.example.com;

    ssl_certificate     /etc/letsencrypt/live/demo.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/demo.example.com/privkey.pem;

    limit_req zone=ws_demo burst=20 nodelay;
    # Both limits answer 503 by default, which makes them indistinguishable in
    # a log or a probe. 429 is the honest code for a rate limit (limit_conn
    # keeps 503, the honest one for "too many at once"), and telling them apart
    # is how you know which flood you are seeing — the rate of new sockets, or
    # the count held open.
    limit_req_status 429;

    # frame-ancestors is the one CSP directive a <meta> tag cannot carry —
    # browsers parse it there and then ignore it, with a console warning and
    # no protection. The page's other directives stay in the meta where they
    # work; this one has to arrive as a header, which means it arrives here.
    # A deployer who skips this proxy gets no clickjacking defence.
    add_header Content-Security-Policy "frame-ancestors 'none'" always;

    # Proxy settings at server level so both locations below inherit them;
    # neither sets a proxy_set_header of its own, which is what would stop
    # the inheritance.
    proxy_http_version 1.1;

    # Host is load-bearing. The demo refuses a WebSocket upgrade whose Origin
    # does not name the host and port in Host; left to nginx's default
    # ($proxy_host, the upstream's own 127.0.0.1:8081), every browser socket
    # is refused with a 403 and nothing in the server's log says so. $host
    # carries no port, so a deployment on a port other than 443 needs
    # $http_host here instead.
    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;

    # Without these the handshake is answered 101 and then the proxy closes
    # the socket, which reads as the server refusing the WebSocket. It is the
    # single most common way this goes wrong.
    proxy_set_header Upgrade    $http_upgrade;
    proxy_set_header Connection $connection_upgrade;

    # The bulletin pushes unprompted, so buffering would hold frames until a
    # buffer filled and turn a 50ms fan-out into whatever nginx felt like.
    # Also the right setting if SSE is ever added.
    proxy_buffering off;

    # Comfortably longer than the server's own WebSocket ping interval, so
    # nginx is never the thing that reaps a socket the server considers
    # alive. Shorter than this and idle tabs drop for no visible reason.
    proxy_read_timeout 300s;

    location / {
        proxy_pass http://127.0.0.1:8081;
    }

    # The socket cap lives on the WebSocket alone. Server-wide it would count
    # HTTP/2 streams too, and one page load opens about ten at once — so two
    # people behind one NAT would start getting 503s on stylesheets. Here it
    # counts open sockets, of which a real visitor holds one per tab. Sixteen
    # leaves room for a household or a small office behind one address; a
    # deployment expecting a large NAT in front of it should raise it, and
    # limit_req with it: every tab holds one socket, and one in view polls
    # /census every two seconds, so sixteen tabs reach this cap before twenty
    # in view reach limit_req's rate.
    location = /ws {
        limit_conn ws_demo_conns 16;
        proxy_pass http://127.0.0.1:8081;
    }
}

server {
    listen 80;
    server_name demo.example.com;
    return 301 https://$host$request_uri;
}
